    {
      "slug": "file-type-detector",
      "name": "File Type Detector",
      "command": "localtools-file-type-detector",
      "category": "dev",
      "description": "Detect real file types from magic bytes and flag extension/MIME mismatches, macros and polyglot files across folders.",
      "port": 47101,
      "kind": "bin",
      "engine": "Go + gabriel-vasile/mimetype + own ZIP/OLE2 container, polyglot and file-name checks",
      "engine_reason": "Pure-Go magic-byte detection for ~200 formats in one static binary: no libmagic, no ONNX runtime (Magika was evaluated and rejected for that reason).",
      "private_repo": "chayprabs/file-type-detector",
      "version": "1.0.1",
      "status": "released",
      "assets": {
        "windows-x64": {
          "url": "https://github.com/chayprabs/localtools/releases/download/file-type-detector-v1.0.1/file-type-detector-1.0.1-windows-x64.zip",
          "sha256": "fded0c42dc1ba7221e2716aa07b8f1ae569c7a4abdf391eaa71eb44506cee2af",
          "size_bytes": 3276814
        },
        "macos-arm64": {
          "url": "https://github.com/chayprabs/localtools/releases/download/file-type-detector-v1.0.1/file-type-detector-1.0.1-macos-arm64.zip",
          "sha256": "5e12e8caa0b7c219d7db607036323eef1587c3ea6d01af1461941b96f54e64aa",
          "size_bytes": 2990813
        },
        "macos-x64": {
          "url": "https://github.com/chayprabs/localtools/releases/download/file-type-detector-v1.0.1/file-type-detector-1.0.1-macos-x64.zip",
          "sha256": "8693956c258a81d2283d03f383da5e715104bac35618f5fba5fce4e98e3c4dd2",
          "size_bytes": 3233221
        },
        "linux-x64": {
          "url": "https://github.com/chayprabs/localtools/releases/download/file-type-detector-v1.0.1/file-type-detector-1.0.1-linux-x64.zip",
          "sha256": "137ebfa75f6b5b2906fecf76bc3e87af88236cd4ae39eeef5145689d1b9d67e3",
          "size_bytes": 3199982
        },
        "linux-arm64": {
          "url": "https://github.com/chayprabs/localtools/releases/download/file-type-detector-v1.0.1/file-type-detector-1.0.1-linux-arm64.zip",
          "sha256": "020b9393a2db4d7d787543c057ddae76303a0ac91cdec503b756918eae5f8065",
          "size_bytes": 2904669
        }
      },
      "release_notes": "Risk only for formats the OS runs on double-click (archived .py/.sh/.bin/.o are info); padded double extensions flagged; MZ files need a real PE header; corrupt or truncated ZIP/OLE containers warned; uploads batched 500 per request; tables scroll on narrow screens; failed updates keep the old install; package-manager installs print the brew/scoop/winget command for update/uninstall.",
      "registries": {
        "brew": true,
        "scoop": true,
        "winget": true,
        "npm": null,
        "pypi": null,
        "ghcr": null
      },
      "requirements": {
        "os": [
          "windows",
          "macos",
          "linux"
        ],
        "disk_mb": 25,
        "docker": false
      },
      "smoke": {
        "path": "/api/detect",
        "fields": {},
        "files": {
          "file": "sample.pdf"
        },
        "expect": "application/pdf"
      },
      "page": {
        "howto": [
          "Open File Type Detector (it starts at http://127.0.0.1:47101).",
          "Drop one or more files on the page, or press \"Choose a folder\" to scan a whole folder.",
          "Press Scan. Risky files are listed first, with the reason for each flag.",
          "Download the results as JSON or CSV.",
          "From a terminal or CI job: localtools-file-type-detector scan <folder> --fail-on risk exits with code 2 when a risky file is found."
        ],
        "faqs": [
          {
            "q": "How does it know the real type if the extension is wrong?",
            "a": "It reads the first bytes of each file (the magic number) and matches them against about 200 known signatures using the mimetype library, then looks inside ZIP and OLE containers. The file name is only used to check for mismatches."
          },
          {
            "q": "What counts as a risky file?",
            "a": "An executable or script named like a document or image, an Office file with VBA macros, an archive that contains executables, a polyglot (for example a PDF that is also a valid ZIP), a double extension like photo.jpg.exe, or a name with a right-to-left override character."
          },
          {
            "q": "Can I use it in CI to block uploads?",
            "a": "Yes. Run localtools-file-type-detector scan <path> --fail-on risk (or --fail-on warn). It exits with code 2 when a file reaches that level, and --json or --csv gives machine-readable output."
          },
          {
            "q": "Are my files uploaded anywhere?",
            "a": "No. The page talks only to the local server on 127.0.0.1, and the tool makes no network requests. Uploaded files are deleted when the request finishes."
          },
          {
            "q": "Why not Google Magika?",
            "a": "Magika needs the ONNX Runtime library, which would turn a single small static binary into a large native bundle, and it is strongest at text and source-code types. The risky formats here (executables, Office containers, archives) have exact byte signatures, so signature matching is faster and explains its answer."
          }
        ]
      }
    },
